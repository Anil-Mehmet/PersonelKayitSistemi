@model PersonelKayitSistemi.Models.PanelViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["ActivePage"] = "Panel";
    Layout = "~/Views/Shared/_LayoutPersonel.cshtml";
}

<div class="page-header">
    <h2 class="page-title">Hoş geldiniz</h2>
    <p class="page-subtitle">Bugünün genel özeti</p>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon stat-icon-blue">
            <i class="bi bi-people"></i>
        </div>
        <div class="stat-info">
            <p class="stat-label">Toplam Personel</p>
            <h3 class="stat-value">@Model.ToplamPersonel</h3>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon stat-icon-green">
            <i class="bi bi-box-arrow-in-right"></i>
        </div>
        <div class="stat-info">
            <p class="stat-label">Bugün Giriş Yapan</p>
            <h3 class="stat-value">@Model.BugunGiris</h3>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon stat-icon-orange">
            <i class="bi bi-box-arrow-left"></i>
        </div>
        <div class="stat-info">
            <p class="stat-label">Bugün Çıkış Yapan</p>
            <h3 class="stat-value">@Model.BugunCikis</h3>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon stat-icon-purple">
            <i class="bi bi-person-check"></i>
        </div>
        <div class="stat-info">
            <p class="stat-label">Şu An İçeride</p>
            <h3 class="stat-value">@Model.SuAnIcerideOlan</h3>
        </div>
    </div>
</div>

<div class="section-card mt-4">
    <div class="section-card-header">
        <h4>Son Hareketler</h4>
        <a href="/Hareketler" class="section-card-link">Tümünü Gör <i class="bi bi-arrow-right"></i></a>
    </div>

    @if (Model.SonHareketler.Any())
    {
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>Giriş Tarihi</th>
                    <th>Çıkış Tarihi</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var hareket in Model.SonHareketler)
                {
                    <tr>
                        <td>@hareket.Personel?.AdSoyad</td>
                        <td>@hareket.GirisTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@(hareket.CikisTarihi.HasValue? hareket.CikisTarihi.Value.ToString("dd.MM.yyyy HH:mm") : "-")</td>
                        <td>
                            @if (hareket.CikisTarihi.HasValue)
                            {
                                <span class="status-badge status-badge-out">Çıkış Yaptı</span>
                            }
                            else
                            {
                                <span class="status-badge status-badge-in">İçeride</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted mb-0">Henüz hareket kaydı yok.</p>
    }
</div>