@model IEnumerable<PersonelKayitSistemi.Models.Personel>

@{
    ViewData["Title"] = "Personel Listesi";
    ViewData["ActivePage"] = "Personel";
    Layout = Context.Session.GetString("AdminEmail") != null
        ? "~/Views/Shared/_LayoutAdmin.cshtml"
        : "~/Views/Shared/_LayoutPersonel.cshtml";
}

<div class="page-header page-header-with-action">
    <div>
        <h2 class="page-title">Personel Listesi</h2>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Yeni Kayıt
    </a>
</div>

@if (ViewBag.Hata != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@ViewBag.Hata</span>
    </div>
}

<div class="section-card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.AdSoyad)</th>
                        <th>@Html.DisplayNameFor(model => model.TCKimlikNo)</th>
                        <th>@Html.DisplayNameFor(model => model.BarkodNo)</th>
                        <th>@Html.DisplayNameFor(model => model.KayitTarihi)</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium">@Html.DisplayFor(modelItem => item.AdSoyad)</td>
                            <td>@Html.DisplayFor(modelItem => item.TCKimlikNo)</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.BarkodNo))
                                {
                                    <span class="barkod-chip">@item.BarkodNo</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@item.KayitTarihi.ToString("dd.MM.yyyy")</td>
                            <td>
                                <div class="table-actions">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="icon-action icon-action-view" title="Detaylar">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="icon-action icon-action-edit" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="icon-action icon-action-delete" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-people"></i>
            <p>Henüz kayıtlı personel yok.</p>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>İlk personeli ekle
            </a>
        </div>
    }
</div>