@model PersonelKayitSistemi.Models.Personel

@{
    ViewData["Title"] = "Yeni Kayıt";
    ViewData["ActivePage"] = "Personel";
    Layout = Context.Session.GetString("AdminEmail") != null
        ? "~/Views/Shared/_LayoutAdmin.cshtml"
        : "~/Views/Shared/_LayoutPersonel.cshtml";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Yeni Personel Kaydı</h2>
    </div>
</div>

<div class="section-card form-card">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group mb-3">
            <label asp-for="AdSoyad" class="form-label"></label>
            <input asp-for="AdSoyad" class="form-control" placeholder="Ad Soyad" />
            <span asp-validation-for="AdSoyad" class="text-danger small"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="TCKimlikNo" class="form-label"></label>
            <input asp-for="TCKimlikNo" class="form-control" placeholder="11 haneli TC kimlik numarası" maxlength="11" />
            <span asp-validation-for="TCKimlikNo" class="text-danger small"></span>
        </div>

        <div class="form-group mb-4">
            <label asp-for="BarkodNo" class="form-label"></label>
            <input asp-for="BarkodNo" class="form-control" placeholder="Personel barkod numarası" />
            <span asp-validation-for="BarkodNo" class="text-danger small"></span>
        </div>

        <input asp-for="KayitTarihi" type="hidden" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss")" />

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Vazgeç
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>Kaydet
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}