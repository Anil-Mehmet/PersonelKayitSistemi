@model List<PersonelKayitSistemi.Models.Hareket>

@{
    ViewData["Title"] = "Hareket Kayıtları";
    ViewData["ActivePage"] = "Hareketler";
    Layout = Context.Session.GetString("AdminEmail") != null
        ? "~/Views/Shared/_LayoutAdmin.cshtml"
        : "~/Views/Shared/_LayoutPersonel.cshtml";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Hareket Kayıtları</h2>
    </div>
</div>

<div class="section-card filter-card mb-4">
    <form method="get" class="filter-form">
        <div class="filter-row">
            <div class="filter-group">
                <label class="form-label">Barkod No</label>
                <input type="text" name="barkodNo" class="form-control" placeholder="Barkod No" value="@ViewBag.BarkodNo" />
            </div>
            <div class="filter-group">
                <label class="form-label">Başlangıç Tarihi</label>
                <input type="datetime-local" name="baslangic" class="form-control" value="@ViewBag.Baslangic" />
            </div>
            <div class="filter-group">
                <label class="form-label">Bitiş Tarihi</label>
                <input type="datetime-local" name="bitis" class="form-control" value="@ViewBag.Bitis" />
            </div>
            <div class="filter-group filter-buttons">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Filtrele
                </button>
                <a href="/Hareketler" class="btn btn-outline-secondary">Temizle</a>
            </div>
        </div>
    </form>
</div>

<div class="section-card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ad Soyad</th>
                        <th>Barkod No</th>
                        <th>Giriş Tarihi</th>
                        <th>Çıkış Tarihi</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hareket in Model)
                    {
                        <tr>
                            <td class="fw-medium">@hareket.Personel.AdSoyad</td>
                            <td>
                                @if (!string.IsNullOrEmpty(hareket.Personel.BarkodNo))
                                {
                                    <span class="barkod-chip">@hareket.Personel.BarkodNo</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@hareket.GirisTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @if (hareket.CikisTarihi.HasValue)
                                {
                                    @hareket.CikisTarihi.Value.ToString("dd.MM.yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (hareket.CikisTarihi.HasValue)
                                {
                                    <span class="status-badge status-badge-out">Çıkış Yaptı</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge-in">İçeride</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-clock-history"></i>
            <p>Filtrenize uygun hareket kaydı bulunamadı.</p>
        </div>
    }
</div>