@model PersonelKayitSistemi.Models.IzinTalebi

@{
    ViewData["Title"] = "Yeni İzin Talebi";
    ViewData["ActivePage"] = "IzinTalepleri";
    Layout = Context.Session.GetString("AdminEmail") != null
        ? "~/Views/Shared/_LayoutAdmin.cshtml"
        : "~/Views/Shared/_LayoutPersonel.cshtml";
}

<div class="page-header">
    <div>
        <h2 class="page-title">Yeni İzin Talebi</h2>
    </div>
</div>

<div class="section-card form-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group mb-3">
            <label class="form-label">Personel</label>
            <select asp-for="PersonelId" class="form-control" asp-items="@(new SelectList(ViewBag.Personeller, "Id", "AdSoyad"))">
                <option value="">-- Personel Seçin --</option>
            </select>
            <span asp-validation-for="PersonelId" class="text-danger small"></span>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">İzin Türü</label>
            <select asp-for="IzinTuru" class="form-control">
                <option value="">-- İzin Türü Seçin --</option>
                <option value="Yıllık İzin">Yıllık İzin</option>
                <option value="Sağlık Raporu">Sağlık Raporu Şartıyla İzin</option>
                <option value="Ücretsiz İzin">Ücretsiz İzin</option>
            </select>
            <span asp-validation-for="IzinTuru" class="text-danger small"></span>
        </div>

        <div class="form-row-split">
            <div class="form-group mb-3">
                <label asp-for="BaslangicTarihi" class="form-label"></label>
                <input asp-for="BaslangicTarihi" type="date" class="form-control" />
                <span asp-validation-for="BaslangicTarihi" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BitisTarihi" class="form-label"></label>
                <input asp-for="BitisTarihi" type="date" class="form-control" />
                <span asp-validation-for="BitisTarihi" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-group mb-4">
            <label asp-for="Aciklama" class="form-label"></label>
            <textarea asp-for="Aciklama" class="form-control" rows="3" placeholder="İsteğe bağlı açıklama..."></textarea>
            <span asp-validation-for="Aciklama" class="text-danger small"></span>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Vazgeç
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>Talebi Oluştur
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}